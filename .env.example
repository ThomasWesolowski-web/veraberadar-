# Vergaberadar – Einstellungen
# Diese Datei als ".env" speichern und anpassen. start.bat legt sie beim ersten Start automatisch an.

# ── Betrieb ──────────────────────────────────────────────
FIRMA_NAME=MT+ Stuckateurmeisterbetrieb Füß & Wesolowski GbR
# Adresse des Betriebssitzes (Straße, PLZ Ort) – nötig für die Entfernungsberechnung
FIRMA_ADRESSE=
# Ausschreibungen weiter weg als diese Kilometer (Luftlinie) werden stark abgewertet. 0 = keine Grenze
MAX_ENTFERNUNG_KM=0

# ── Suchlauf ─────────────────────────────────────────────
# Zeitplan im Cron-Format (Minute Stunde Tag Monat Wochentag). Standard: täglich 06:00 Uhr.
# Gilt, solange der Vergaberadar läuft. Wer stattdessen taeglicher-suchlauf-einrichten.bat nutzt,
# lässt diesen Wert leer, damit nicht zweimal gesucht wird.
SUCHLAUF_ZEITPLAN=0 6 * * *
SUCHLAUF_BEIM_START=false
# Angebundene Quellen (kommagetrennt): ted, oeffentlichevergabe, servicebund
QUELLEN=ted,oeffentlichevergabe,servicebund
# Wie viele Tage rückwirkend gesucht wird (für den ersten Lauf ruhig 14–30 eintragen)
TAGE_ZURUECK=7

# ── Relevanz ─────────────────────────────────────────────
# Ab dieser Punktzahl (0–100) erscheint eine Ausschreibung in der Liste
MINDEST_PUNKTE_ANZEIGE=20
# Ab dieser Punktzahl wird per E-Mail gemeldet
MINDEST_PUNKTE_MAIL=60

# ── Entfernung (OpenStreetMap, kostenlos) ────────────────
GEO_AKTIV=true
# Kontakt-E-Mail für OpenStreetMap (empfohlen laut Nutzungsrichtlinie)
GEO_KONTAKT_EMAIL=

# ── E-Mail über Ihr eigenes Postfach ─────────────────────
MAIL_AKTIV=false
SMTP_HOST=
SMTP_PORT=587
# true bei Port 465
SMTP_SSL=false
SMTP_BENUTZER=
SMTP_PASSWORT=
MAIL_ABSENDER=
# Mehrere Empfänger mit Komma trennen
MAIL_EMPFAENGER=

# ── Lokale KI (optional, Ollama) ─────────────────────────
KI_AKTIV=false
KI_OLLAMA_URL=http://localhost:11434
KI_MODELL=qwen2.5:7b
KI_MAX_PRO_LAUF=20

# ── Technik ──────────────────────────────────────────────
PORT=3000
# 127.0.0.1 = nur dieser PC. 0.0.0.0 = im ganzen Netzwerk (dann ZUGANGSTOKEN setzen!)
HOST=127.0.0.1
ZUGANGSTOKEN=
UNTERLAGEN_MAX_MB=50
