{
  "name": "xrechnung-generator",
  "version": "1.2.0",
  "private": true,
  "description": "Erstellt und prüft E-Rechnungen als XRechnung 3.0 (UBL) oder ZUGFeRD 2.3 (PDF/A-3 mit CII) aus PDF- oder XML-Rechnungen",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "npx --yes http-server -c-1 -p 8080 .",
    "app": "electron .",
    "dist:win": "node installer/build-windows.mjs",
    "validate:official": "tools/official-validation.sh"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@xmldom/xmldom": "^0.8.10",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "pdf-lib": "^1.17.1"
  },
  "productName": "XRechnung-Generator",
  "author": "XRechnung-Generator",
  "main": "electron/main.cjs",
  "build": {
    "appId": "de.xrechnung.generator",
    "productName": "XRechnung-Generator",
    "copyright": "Alle Daten bleiben lokal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "vendor/**",
      "docs/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "XRechnung-Generator-Setup-${version}.${ext}"
    },
    "electronLanguages": [
      "de",
      "en-US"
    ]
  }
}
